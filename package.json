{
  "name": "dctm-notebook",
  "displayName": "DCTM Notebook",
  "description": "VS Code notebook interface for DQL queries with REST and DFC connectivity",
  "version": "1.0.4",
  "publisher": "spirecentral",
  "icon": "resources/icon.png",
  "engines": {
    "vscode": "^1.84.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "documentum",
    "dql",
    "opentext",
    "content management",
    "ecm"
  ],
  "activationEvents": [
    "onWebviewPanel:dctmConnectionWorkspace"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "documentum",
          "title": "Documentum",
          "icon": "resources/documentum.svg"
        }
      ]
    },
    "notebooks": [
      {
        "type": "dctmbook",
        "displayName": "Documentum Notebook",
        "selector": [
          {
            "filenamePattern": "*.dctmbook"
          }
        ]
      }
    ],
    "notebookRenderer": [
      {
        "id": "dctm-result-renderer",
        "displayName": "Documentum Result Renderer",
        "entrypoint": "./out/notebook/renderer.js",
        "requiresMessaging": "always",
        "mimeTypes": [
          "application/x-dctm-result"
        ]
      }
    ],
    "languages": [
      {
        "id": "dql",
        "aliases": [
          "DQL",
          "Documentum Query Language"
        ],
        "extensions": [
          ".dql"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "dmapi",
        "aliases": [
          "DMAPI",
          "Documentum API"
        ],
        "extensions": [
          ".dmapi"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "configurationDefaults": {
      "[dql]": {
        "editor.wordBasedSuggestions": "off"
      }
    },
    "grammars": [
      {
        "language": "dql",
        "scopeName": "source.dql",
        "path": "./syntaxes/dql.tmLanguage.json"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "dql",
        "scopes": {
          "type": [
            "entity.name.type.dql"
          ]
        }
      }
    ],
    "commands": [
      {
        "command": "dctm.connect",
        "title": "Connect to Documentum",
        "category": "Documentum"
      },
      {
        "command": "dctm.disconnect",
        "title": "Disconnect from Documentum",
        "category": "Documentum"
      },
      {
        "command": "dctm.executeDql",
        "title": "Execute DQL Query",
        "category": "Documentum"
      },
      {
        "command": "dctm.showConnections",
        "title": "Show Connections",
        "category": "Documentum"
      },
      {
        "command": "dctm.linkConnection",
        "title": "Link to Connection",
        "category": "Documentum"
      },
      {
        "command": "dctm.openWorkspace",
        "title": "Open Workspace",
        "category": "Documentum"
      },
      {
        "command": "dctm.workspace.dump",
        "title": "Dump",
        "category": "Documentum"
      },
      {
        "command": "dctm.workspace.refreshFolder",
        "title": "Refresh",
        "category": "Documentum"
      },
      {
        "command": "dctm.workspace.generateQuery",
        "title": "Generate DQL Query",
        "category": "Documentum"
      },
      {
        "command": "dctm.manageConnections",
        "title": "Manage Connections",
        "category": "Documentum",
        "icon": "$(gear)"
      },
      {
        "command": "dctm.refreshConnections",
        "title": "Refresh Connections",
        "category": "Documentum",
        "icon": "$(refresh)"
      },
      {
        "command": "dctm.connectFromTree",
        "title": "Connect",
        "category": "Documentum",
        "icon": "$(plug)"
      },
      {
        "command": "dctm.disconnectFromTree",
        "title": "Disconnect",
        "category": "Documentum",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "dctm.executeApiOnObject",
        "title": "Execute API Method",
        "category": "Documentum"
      },
      {
        "command": "dctm.checkout",
        "title": "Checkout",
        "category": "Documentum"
      },
      {
        "command": "dctm.checkin",
        "title": "Checkin",
        "category": "Documentum"
      },
      {
        "command": "dctm.cancelCheckout",
        "title": "Cancel Checkout",
        "category": "Documentum"
      },
      {
        "command": "dctm.notebook.insertDqlCell",
        "title": "Insert DQL Cell",
        "category": "Documentum Notebook",
        "icon": "$(add)"
      },
      {
        "command": "dctm.notebook.insertApiCell",
        "title": "Insert API Cell",
        "category": "Documentum Notebook",
        "icon": "$(terminal)"
      },
      {
        "command": "dctm.notebook.insertMarkdownCell",
        "title": "Insert Markdown Cell",
        "category": "Documentum Notebook",
        "icon": "$(markdown)"
      },
      {
        "command": "dctm.notebook.toggleOutputFormat",
        "title": "Toggle Output Format (HTML/JSON)",
        "category": "Documentum Notebook",
        "icon": "$(symbol-misc)"
      },
      {
        "command": "dctm.notebook.bindConnection",
        "title": "Bind to Connection",
        "category": "Documentum Notebook",
        "icon": "$(link)"
      },
      {
        "command": "dctm.notebook.unbindConnection",
        "title": "Unbind Connection",
        "category": "Documentum Notebook",
        "icon": "$(link-external)"
      }
    ],
    "views": {
      "documentum": [
        {
          "id": "documentumConnections",
          "name": "Connections",
          "contextualTitle": "Documentum Connections"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "documentumConnections",
        "contents": "No Documentum connections configured.\n[Add Connection](command:dctm.manageConnections?%7B%22newConnection%22%3Atrue%7D)"
      }
    ],
    "configuration": {
      "title": "Documentum",
      "properties": {
        "documentum.connections": {
          "type": "array",
          "default": [],
          "description": "Documentum connections. Use the Documentum: Manage Connections command to add, edit or delete them.",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Connection display name"
              },
              "type": {
                "type": "string",
                "enum": [
                  "dfc",
                  "rest"
                ],
                "default": "dfc",
                "description": "dfc connects through the DFC Bridge and needs docbroker and port. rest connects through the REST Bridge and needs endpoint."
              },
              "endpoint": {
                "type": "string",
                "description": "REST only, required. REST API endpoint URL."
              },
              "docbroker": {
                "type": "string",
                "description": "DFC only, required. Docbroker host name or IP address."
              },
              "port": {
                "type": "number",
                "default": 1489,
                "description": "DFC only, required. Docbroker port."
              },
              "repository": {
                "type": "string",
                "description": "Repository/docbase name"
              },
              "username": {
                "type": "string",
                "description": "Username for authentication"
              }
            },
            "required": [
              "name",
              "type",
              "repository"
            ],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "dfc"
                    }
                  }
                },
                "then": {
                  "required": [
                    "docbroker"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "rest"
                    }
                  }
                },
                "then": {
                  "required": [
                    "endpoint"
                  ]
                }
              }
            ],
            "defaultSnippets": [
              {
                "label": "DFC connection",
                "description": "A connection through the DFC Bridge",
                "body": {
                  "name": "${1:name}",
                  "type": "dfc",
                  "repository": "${2:repository}",
                  "docbroker": "${3:docbroker}",
                  "port": 1489
                }
              },
              {
                "label": "REST connection",
                "description": "A connection through the REST Bridge",
                "body": {
                  "name": "${1:name}",
                  "type": "rest",
                  "repository": "${2:repository}",
                  "endpoint": "${3:http://host:8080/dctm-rest}"
                }
              }
            ]
          }
        },
        "documentum.bridge.host": {
          "type": "string",
          "default": "localhost",
          "description": "Hostname or IP address where the bridge services are running"
        },
        "documentum.bridge.port": {
          "type": "number",
          "default": 9876,
          "description": "Port for DFC Bridge microservice (DFC connections)"
        },
        "documentum.bridge.restPort": {
          "type": "number",
          "default": 9877,
          "description": "Port for REST Bridge microservice (REST connections)"
        },
        "documentum.bridge.queryTimeout": {
          "type": "number",
          "default": 300,
          "minimum": 0,
          "description": "Timeout in seconds for DQL queries, dmAPI commands and API method calls. 0 means no timeout."
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "command": "dctm.executeDql",
          "when": "editorLangId == dql",
          "group": "documentum"
        },
        {
          "command": "dctm.linkConnection",
          "when": "editorLangId == dql",
          "group": "documentum"
        }
      ],
      "view/title": [
        {
          "command": "dctm.refreshConnections",
          "when": "view == documentumConnections",
          "group": "navigation@2"
        },
        {
          "command": "dctm.manageConnections",
          "when": "view == documentumConnections",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "dctm.connectFromTree",
          "when": "view == documentumConnections && viewItem == connection-disconnected",
          "group": "inline"
        },
        {
          "command": "dctm.disconnectFromTree",
          "when": "view == documentumConnections && viewItem == connection-connected",
          "group": "inline"
        }
      ],
      "webview/context": [
        {
          "command": "dctm.workspace.dump",
          "when": "webviewId == 'dctmConnectionWorkspace' && webviewSection =~ /^(cabinet|folder|document|type|user|group)$/",
          "group": "1_dump"
        },
        {
          "command": "dctm.workspace.generateQuery",
          "when": "webviewId == 'dctmConnectionWorkspace' && webviewSection =~ /^(type|user|group)$/",
          "group": "2_query"
        },
        {
          "command": "dctm.executeApiOnObject",
          "when": "webviewId == 'dctmConnectionWorkspace' && webviewSection =~ /^(cabinet|folder|document)$/",
          "group": "2_api"
        },
        {
          "command": "dctm.workspace.refreshFolder",
          "when": "webviewId == 'dctmConnectionWorkspace' && webviewSection =~ /^(cabinet|folder)$/",
          "group": "3_refresh"
        },
        {
          "command": "dctm.checkout",
          "when": "webviewId == 'dctmConnectionWorkspace' && webviewSection == 'document'",
          "group": "4_version@1"
        },
        {
          "command": "dctm.checkin",
          "when": "webviewId == 'dctmConnectionWorkspace' && webviewSection == 'document'",
          "group": "4_version@2"
        },
        {
          "command": "dctm.cancelCheckout",
          "when": "webviewId == 'dctmConnectionWorkspace' && webviewSection == 'document'",
          "group": "4_version@3"
        }
      ],
      "notebook/cell/title": [
        {
          "command": "dctm.notebook.toggleOutputFormat",
          "when": "notebookType == dctmbook && notebookCellType == code",
          "group": "inline@1"
        }
      ],
      "notebook/toolbar": [
        {
          "command": "dctm.notebook.bindConnection",
          "when": "notebookType == dctmbook && !dctm.notebookBound",
          "group": "navigation@1"
        },
        {
          "command": "dctm.notebook.unbindConnection",
          "when": "notebookType == dctmbook && dctm.notebookBound",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "dctm.linkConnection",
          "when": "editorLangId == dql"
        },
        {
          "command": "dctm.workspace.dump",
          "when": "false"
        },
        {
          "command": "dctm.workspace.refreshFolder",
          "when": "false"
        },
        {
          "command": "dctm.workspace.generateQuery",
          "when": "false"
        },
        {
          "command": "dctm.connectFromTree",
          "when": "false"
        },
        {
          "command": "dctm.disconnectFromTree",
          "when": "false"
        },
        {
          "command": "dctm.checkout",
          "when": "false"
        },
        {
          "command": "dctm.checkin",
          "when": "false"
        },
        {
          "command": "dctm.cancelCheckout",
          "when": "false"
        },
        {
          "command": "dctm.notebook.bindConnection",
          "when": "notebookType == dctmbook && !dctm.notebookBound"
        },
        {
          "command": "dctm.notebook.unbindConnection",
          "when": "notebookType == dctmbook && dctm.notebookBound"
        }
      ]
    },
    "keybindings": [
      {
        "command": "dctm.executeDql",
        "key": "ctrl+shift+e",
        "mac": "cmd+shift+e",
        "when": "editorLangId == dql"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc -b --watch --noEmit tsconfig.json tsconfig.renderer.json tsconfig.webviews.json",
    "package": "npm run check-types && node esbuild.js --production",
    "check-types": "tsc --noEmit && tsc --noEmit -p tsconfig.webviews.json && tsc --noEmit -p tsconfig.renderer.json",
    "compile-tests": "node -e \"require('fs').rmSync('out-test', { recursive: true, force: true })\" && tsc -p . --outDir out-test",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^18.19.130",
    "@types/vscode": "^1.84.0",
    "@types/vscode-notebook-renderer": "^1.72.4",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "@vscode/codicons": "^0.0.46-24",
    "@vscode/test-cli": "^0.0.4",
    "@vscode/test-electron": "^2.3.8",
    "esbuild": "^0.27.2",
    "eslint": "^8.56.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.44.0",
    "@lezer/highlight": "^1.2.5",
    "axios": "^1.6.2",
    "exceljs": "^4.4.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tonychristie/dctm-notebook.git"
  },
  "homepage": "https://github.com/tonychristie/dctm-notebook",
  "bugs": {
    "url": "https://github.com/tonychristie/dctm-notebook/issues"
  }
}
